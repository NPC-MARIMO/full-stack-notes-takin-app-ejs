<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notes App</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold text-center mb-8">Welcome to Notes App</h1>
    
    <% if (user) { %>
      <div class="text-center">
        <p class="mb-4">Welcome back, <%= user.email %></p>
        <a href="/notes" class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">View Notes</a>
        <a href="/logout" class="ml-4 bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600">Logout</a>
      </div>
    <% } else { %>
      <div class="text-center">
        <a href="/login" class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">Login</a>
        <a href="/register" class="ml-4 bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600">Register</a>
      </div>
    <% } %>
  </div>
</body>
</html>